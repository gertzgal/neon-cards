{
  "name": "@neon-cards/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port ${WORKER_PORT:-8787} --var DEV_RIG:${DEV_RIG:-1}",
    "start": "wrangler d1 migrations apply DB --local --persist-to ${PERSIST_DIR:-.wrangler/state} && wrangler dev --port ${PORT:-8787} --var DEV_RIG:${DEV_RIG:-1} --persist-to ${PERSIST_DIR:-.wrangler/state}",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "typegen": "wrangler types --include-runtime false",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@neon-cards/engine": "workspace:*",
    "@neon-cards/game-blackjack": "workspace:*",
    "@neon-cards/game-flip7": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "wrangler": "^4.149.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261010.1"
  }
}
